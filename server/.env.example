# Copy to .env and fill in. Never commit the real .env.

# --- HTTP server ---
PORT=3000
NODE_ENV=development
# Comma-separated list of origins allowed by CORS (FRONTEND_URL is always added).
# Leave empty to use the built-in defaults (localhost:5173 + the Vercel deployments).
CORS_ORIGINS=
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info
# Where uploaded files are stored (relative to the server folder or absolute).
UPLOADS_DIR=uploads

# --- Database (MySQL 8) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=LicentaDB
DB_USER=root
DB_PASS=change-me
# Apply pending migrations on startup (handy on hosts without a shell).
DB_MIGRATE_ON_START=true
DB_LOGGING=false
# TLS to the database: required by most hosted MySQL providers. Add DB_SSL_CA_FILE when the
# provider gives you its own CA certificate (on Render: a Secret File, e.g. /etc/secrets/ca.pem).
DB_SSL=false
# DB_SSL_CA_FILE=
# Free-tier databases suspend after a few idle minutes: a `SELECT 1` every 2–4 minutes
# (random) keeps them awake. Set DB_KEEPALIVE=false when the database never sleeps.
DB_KEEPALIVE=true
DB_KEEPALIVE_MIN_MINUTES=2
DB_KEEPALIVE_MAX_MINUTES=4

# --- Staying awake on Render's free plan ---
# Render stops a free API after 15 minutes without incoming requests. The server pings its own
# /health every 5–9 minutes (random) through its public address: RENDER_EXTERNAL_URL, which Render
# sets by itself, or KEEP_AWAKE_URL. Nothing happens locally unless KEEP_AWAKE_URL is set.
KEEP_AWAKE=true
# KEEP_AWAKE_URL=
KEEP_AWAKE_MIN_MINUTES=5
KEEP_AWAKE_MAX_MINUTES=9

# --- Auth ---
# Long random string used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET_KEY=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h

# --- AI provider: DeepInfra (embeddings for recommendations, emotion analysis) ---
# Create a key at https://deepinfra.com/dash/api_keys. Without it, AI features are disabled.
# Models, vector size and the other tunables are edited in the admin panel, not here.
DEEPINFRA_API_KEY=
# DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
# AI_REQUEST_TIMEOUT_MS=60000

# --- Book metadata (optional) ---
# Google Books key for the extra details on the book page (publisher, year, pages). Server-side
# only; without it Google applies a lower shared quota.
GOOGLE_BOOKS_API_KEY=
# Hosts whose cover images the API may proxy (comma-separated, HTTPS only, subdomains included).
# COVER_IMAGE_HOSTS=dc5.ro

# --- Upload storage: Cloudflare R2 (optional) ---
# Set R2_BUCKET to store uploads on R2 instead of UPLOADS_DIR (required on hosts without a
# persistent disk). Create an R2 API token with "Object Read & Write" on the bucket, and enable
# public access (r2.dev subdomain or a custom domain) for R2_PUBLIC_URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_FOLDER=aurora-codex
